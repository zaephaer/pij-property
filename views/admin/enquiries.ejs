<%- include('../partials/ahead') %>
<%
  // wa.me needs the number in international form without "+": 012-345 6789 -> 60123456789
  function waLink(x) {
    var d = String(x.phone || '').replace(/\D/g, '');
    if (d.length < 8) return '';
    if (d.charAt(0) === '0') d = '60' + d.slice(1); else if (d.slice(0, 2) !== '60') d = '60' + d;
    var pontian = /pontian/i.test(x.project || '');
    var msg = 'Salam ' + x.name + ', terima kasih kerana berminat dengan ' + (x.project || 'projek kami') + '.\n\n' + (pontian
      ? 'Maklumat ringkas:\n• Rumah teres 2 tingkat (RMMJ Jenis B), 3 bilik tidur, 2 bilik air, 850 kaki persegi\n• Harga RM100,000\n• 37 unit ditawarkan\n• Khas untuk pengundi dalam kawasan Parlimen Pontian dan Tanjung Piai (Awam Melayu sahaja)\n• Lokasi: Jalan Parit Ibrahim, Pontian, berdekatan Masjid Jamek Jalan Parit Ibrahim (https://maps.app.goo.gl/BZzvtSp7fhV4Fd1C6)\n\nSyarat utama:\n• Warganegara Malaysia, menetap 10 tahun di Johor, berusia 18 tahun ke atas\n• Berdaftar sebagai pengundi Parlimen Pontian atau Tanjung Piai\n• Pendapatan isi rumah (pemohon dan pasangan) tidak melebihi RM6,000\n• Pemohon dan pasangan tidak memiliki atau tidak pernah memiliki rumah kediaman\n\nDokumen utama: kad pengenalan, sijil kelahiran, sijil nikah/perceraian/kematian, dan pengesahan pendapatan (slip gaji 3 bulan, surat majikan, penyata KWSP; atau akuan sumpah jika bekerja sendiri/tidak bekerja).\n\nPermohonan dibuka 3 Nov hingga 3 Dis 2026 melalui: pkpj.johor.gov.my\n\n'
      : '') + 'Jika ada soalan lanjut, boleh hubungi kami di 06-2266366.\n\nPIJ Property Development Sdn. Bhd.';
    return 'https://wa.me/' + d + '?text=' + encodeURIComponent(msg);
  }
%>
<div class="bar"><h1>Pertanyaan</h1><a class="btn" href="/admin/pertanyaan.csv">Eksport CSV</a></div>
<table>
  <thead><tr><th>Tarikh</th><th>Nama</th><th>Telefon</th><th>Emel</th><th>Projek</th><th>Mesej</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="8">Tiada pertanyaan.</td></tr><% } %>
  <% rows.forEach(function(x){ %>
    <tr><td><%= x.created_at %></td><td><%= x.name %></td><td><%= x.phone %><% if (waLink(x)) { %><br><a class="btn" style="padding:2px 10px;font-size:12px;margin-top:4px" target="_blank" rel="noopener" href="<%= waLink(x) %>">WhatsApp</a><% } %></td><td><%= x.email %></td><td><%= x.project %></td><td><%= x.message %></td>
      <td><form method="post" action="/admin/pertanyaan/<%= x.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status" class="st-sel st-<%= x.status || 'baharu' %>" onchange="this.form.submit()"><% ['baharu','dihubungi','selesai'].forEach(function(s){ %><option <%= (x.status || 'baharu') === s ? 'selected' : '' %>><%= s %></option><% }) %></select></form></td>
      <td class="act"><form method="post" action="/admin/pertanyaan/<%= x.id %>/padam" onsubmit="return confirm('Padam?')">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger">Padam</button></form></td></tr>
  <% }) %>
  </tbody>
</table>
<%- include('../partials/afoot') %>
