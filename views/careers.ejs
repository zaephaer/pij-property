<%- include('partials/head', {pageTitle: S.nav_careers}) %>
<section class="page-h"><div class="wrap"><h1><%= S.nav_careers %></h1></div></section>
<section class="sec"><div class="wrap prose">
  <% if (!items.length) { %><p class="muted"><%= S.none %></p><% } %>
  <% items.forEach(function(c){ %>
    <article class="job">
      <h2><%= pick(c,'title') %> <span class="tag <%= c.closed ? 't-cadangan' : 't-siap' %>"><%= c.closed ? S.tender_closed : S.tender_open %></span></h2>
      <% if (c.closing_date) { %><p class="muted"><%= S.tender_close %>: <%= date(c.closing_date) %></p><% } %>
      <div class="pre"><%= pick(c,'body') %></div>
    </article>
  <% }) %>
  <p><a class="btn" href="mailto:<%= st.notify_email %>"><%= S.apply %></a></p>
</div></section>
<%- include('partials/foot') %>
