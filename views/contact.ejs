    <p><strong><%= S.office_hours %></strong><br><%= st['hours_' + lang] %></p>
    <p><a class="btn btn-line" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Bangunan+PIJ+Holdings+Jalan+Bukit+Timbalan+Johor+Bahru">Google Maps</a></p>
  </div>
  <div>
    <h3><%= S.enquire %></h3>
    <%- include('partials/enquiry', {project: selected, back: base + '/hubungi'}) %>
  </div>
</div></section>
<%- include('partials/foot') %>
