<%- include('partials/head', {preloadImage: '/img/p/hero-jb.jpg'}) %>
<section class="hero" style="background-image:linear-gradient(100deg,rgba(6,60,45,.86) 0%,rgba(6,60,45,.7) 55%,rgba(6,60,45,.2) 100%),url('/img/p/hero-jb.jpg')">
  <div class="wrap">
    <h1><%= S.hero_title %></h1>
    <p><%= S.hero_sub %></p>
    <div class="paths">
      <a class="path" href="<%= base %>/projek"><strong><%= S.path_buy %></strong><span><%= S.path_buy_d %></span></a>
      <a class="path alt" href="<%= base %>/perkhidmatan/pembangunan-hartanah"><strong><%= S.path_corp %></strong><span><%= S.path_corp_d %></span></a>
    </div>
  </div>
</section>

<section class="stats"><div class="wrap grid4">
  <div><b>7,862</b><span><%= S.stat_homes %></span></div>
  <div><b>100</b><span><%= S.stat_shops %></span></div>
  <div><b>RM2.16b</b><span><%= S.stat_gdc %></span></div>
  <div><b>RM2.64b</b><span><%= S.stat_gdv %></span></div>
</div></section>

<section class="sec"><div class="wrap">
  <div class="sec-h"><h2><%= S.featured %></h2><a href="<%= base %>/projek"><%= S.all_projects %> &rarr;</a></div>
  <div class="cards">
    <% featured.forEach(function(p){ %>
      <a class="card" href="<%= base %>/projek/<%= p.slug %>">
        <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
        <div class="card-b"><span class="tag t-<%= p.status %>"><%= S['status_' + p.status] %></span>
          <h3><%= p.name %></h3><p class="muted"><%= p.location %><%= p.units ? ' · ' + p.units : '' %></p></div>
      </a>
    <% }) %>
  </div>
</div></section>

<section class="sec brand-band" aria-label="PIJ Property">
  <div class="wrap">
    <figure class="brand-video" id="brandVideo">
      <video muted playsinline preload="none" poster="/media/logo-reveal-poster.jpg" aria-label="PIJ Property">
        <source src="/media/logo-reveal.mp4" type="video/mp4">
      </video>
      <button type="button" class="replay" id="brandReplay" aria-label="<%= S.replay %>" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 3-6.2M4 4v5h5"/></svg><%= S.replay %>
      </button>
    </figure>
    <p class="brand-line"><%= S.brand_line %> <a href="<%= base %>/kenali-kami/profil"><%= S.know_us %> &rarr;</a></p>
  </div>
</section>
<script>
(function () {
  var box = document.getElementById('brandVideo'); if (!box) return;
  var v = box.querySelector('video'), btn = document.getElementById('brandReplay');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  v.addEventListener('ended', function () { btn.hidden = false; });
  btn.addEventListener('click', function () { btn.hidden = true; v.currentTime = 0; v.play(); });
  if (reduce) { btn.hidden = false; return; }          // poster only; user can press replay
  if (!('IntersectionObserver' in window)) { btn.hidden = false; return; }
  var io = new IntersectionObserver(function (es) {
    if (es[0].isIntersecting) { io.disconnect(); v.play().catch(function () { btn.hidden = false; }); }
  }, { threshold: 0.5 });
  io.observe(box);
})();
</script>

<% if (news.length || tenders.length) { %>
<section class="sec alt"><div class="wrap two">
  <div>
    <div class="sec-h"><h2><%= S.latest_news %></h2><a href="<%= base %>/berita"><%= S.all_news %> &rarr;</a></div>
    <% if (!news.length) { %><p class="muted"><%= S.none %></p><% } %>
    <% news.forEach(function(n){ %><a class="row" href="<%= base %>/berita/<%= n.id %>"><span class="muted"><%= date(n.published_at) %></span><strong><%= pick(n,'title') %></strong></a><% }) %>
  </div>
  <div>
    <div class="sec-h"><h2><%= S.open_tenders %></h2><a href="<%= base %>/tender"><%= S.all_tenders %> &rarr;</a></div>
    <% if (!tenders.length) { %><p class="muted"><%= S.none %></p><% } %>
    <% tenders.forEach(function(t){ %><a class="row" href="<%= base %>/tender/<%= t.id %>"><span class="muted"><%= S.tender_close %>: <%= date(t.closing_date) %></span><strong><%= pick(t,'title') %></strong></a><% }) %>
  </div>
</div></section>
<% } %>

<section class="sec"><div class="wrap cta">
  <h2><%= S.enquire %></h2><p class="muted"><%= S.enquire_note %></p>
  <%- include('partials/enquiry', {project: '', back: base + '/'}) %>
</div></section>
<%- include('partials/foot') %>

