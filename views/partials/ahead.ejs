<!doctype html>
<html lang="ms"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Admin | PIJ Property</title>
<link rel="stylesheet" href="/css/fonts.css">
<link rel="stylesheet" href="/css/admin.css">
<script>try{if(localStorage.getItem('pij.side')==='1')document.documentElement.classList.add('side-collapsed')}catch(e){}</script>
</head>
<body>
<% if (me) {
  var IC = {
    dashboard: 'M4 4h7v9H4zM13 4h7v5h-7zM13 11h7v9h-7zM4 15h7v5H4z',
    pensijilan: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM8.5 12l2.5 2.5 4.5-5',
    berita: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7',
    tender: 'M9 4h6v3H9zM6 5h3M15 5h3v16H6V5M9 12l2 2 4-4',
    projek: 'M4 21V4h10v17M14 9h6v12M8 8h2M8 12h2M8 16h2',
    'muat-turun': 'M12 4v11M7 11l5 5 5-5M5 20h14',
    kerjaya: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20v-1.5A4.5 4.5 0 0 1 7 14h4a4.5 4.5 0 0 1 4.5 4.5V20M17 11a2.5 2.5 0 1 0 0-5M18 20v-1a4 4 0 0 0-2-3.4',
    pengguna: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1',
    pertanyaan: 'M3 6h18v12H3zM3 7l9 7 9-7',
    tetapan: 'M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0M14 4v4M8 10v4M16 16v4',
    laman: 'M14 4h6v6M20 4l-9 9M18 14v6H4V6h6',
    keluar: 'M9 4H5v16h4M16 8l4 4-4 4M20 12H9'
  };
  var svg = function(k){ return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + IC[k] + '"/></svg>'; };
%>
<aside class="side" id="side">
  <div class="side-top">
    <a class="brand" href="/admin" title="Papan pemuka">
      <img class="logo-full" src="/img/logo-white.png" alt="PIJ Property">
      <img class="logo-mini" src="/img/logo-icon.png" alt="PIJ Property">
    </a>
    <button class="collapse" type="button" aria-label="Lipat sidebar" aria-controls="side" title="Lipat / kembang"
      onclick="var c=document.documentElement.classList.toggle('side-collapsed');try{localStorage.setItem('pij.side',c?'1':'0')}catch(e){}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
    </button>
  </div>
  <nav>
    <a href="/admin" title="Dashboard"><%- svg('dashboard') %><span>Dashboard</span></a>
    <% Object.keys(resources).forEach(function(k){ %>
      <a href="/admin/<%= k %>" title="<%= resources[k].label %>"><%- svg(k) %><span><%= resources[k].label %></span></a>
    <% }) %>
    <a href="/admin/pertanyaan" title="Pertanyaan"><%- svg('pertanyaan') %><span>Pertanyaan</span></a>
    <a href="/admin/tetapan" title="Tetapan"><%- svg('tetapan') %><span>Tetapan</span></a>
    <a href="/ms" target="_blank" rel="noopener" title="Lihat laman"><%- svg('laman') %><span>Lihat laman</span></a>
  </nav>
  <form method="post" action="/admin/logout">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="link out" title="Log keluar (<%= me.name %>)"><%- svg('keluar') %><span>Log keluar</span></button>
  </form>
</aside>
<% } %>
<main class="<%= me ? 'with-side' : 'center' %>">
